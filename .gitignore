# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# pnpm local content-addressable store — generated by pnpm install, holds
# ~20k+ package blobs. Never commit. Lives at repo root when pnpm is configured
# with a local store-dir (which this project does).
.pnpm-store/
# Local editor/assistant tooling state — per-developer, not project source.
.claude/
# AI agent memory bank — per-developer working notes, not project source.
.ai-agents/
# DeepSeek Harness state and its project-level skill roots. Local, per-machine links to
# the private agent/ root, so they are never committed; the public sync excludes them by
# name as well (rsync does not read .gitignore).
.dsh/
.agents/
# Reasonix tool state/config — local-only, never for project source or public sync.
.reasonix/
reasonix.toml
# Locally extracted release tooling that is not an npm dependency — currently
# Sparkle's `sign_update`, unpacked from the release tarball so it survives an
# Xcode DerivedData wipe. Binaries, per-machine: never committed.
.tools/
# asdf per-developer tool version pin — the project pins Node via Volta
# (see package.json), so this is local-only and never for project source.
.tool-versions
# npm lockfile — the project standardizes on pnpm (see "packageManager" in
# package.json and the committed pnpm-lock.yaml). A stray package-lock.json
# is a local artifact of running npm directly and must never be committed
# alongside pnpm-lock.yaml.
package-lock.json
# All build output lives here — generated, never committed. Includes:
#   releases/web/      built React SPA
#   releases/mac/      Node server bundle for macOS
#   releases/mac-dmg/  signed + notarized DMGs (shippable)
#   releases/mac-pkg/  legacy .pkg installer
#   releases/win/      Node server bundle for Windows
#   releases/win-pkg/  Inno Setup installer (nebulis-setup.exe)
releases/
dist-ssr
# NSSM binary — downloaded by scripts/download-nssm.mjs or CI
installers/windows/installer/nssm.exe
*.local
/data/

# Secrets — never commit credentials or private keys
.env*
*.pem
*.key

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
test-results/*
trace/*
playwright-report/
coverage/
server/dist/
build/Release/
*.node
.pkg-cache/

church-*.md
audit-*.md

# Church purist audit reports (local-only)
church-audit/

# .NET / C# build outputs (Windows tray app at installers/windows/tray/)
# bin/ holds compiled DLLs and the published Nebulis.Tray.exe; obj/ holds
# intermediate build artifacts and NuGet restore cache. Both are regenerated
# by `dotnet publish` and must not be tracked.
installers/windows/tray/bin/
installers/windows/tray/obj/
# Defensive: catch any other .NET project bin/obj that gets added later.
**/bin/Debug/
**/bin/Release/
**/bin/publish/
**/obj/Debug/
**/obj/Release/
# Visual Studio / Rider local files
*.user
*.suo
*.lscache
.vs/
.idea/
# .NET coverage and test results
TestResults/
.env

# Vitest temp DATA_DIRs. Some backend tests need a DATA_DIR outside os.tmpdir()
# (import.ts's defense-in-depth check refuses upload tempPaths outside
# os.tmpdir(), so the destination library dir must live elsewhere). They now
# mkdtemp under .test-tmp/, which tests/globalSetup.ts wipes before each run.
.test-tmp/
# Isolated test database — DATA_DIR for the Vitest worker (never the dev DB).
.test-data/
# Legacy: older runs wrote these directly to the repo root. Kept ignored so any
# stragglers from before the .test-tmp/ change don't show up in git.
nebulis-*-test-*/

# Verification ladder output (scripts/verify.mjs) — a per-run artifact bound to
# one revision, regenerated on every `npm run verify`. Not project source.
verify-report.json
verify-report.html

# Import Lab: generated fixtures and test reports
tests/fixtures/import-lab/generated/
tests/fixtures/import-lab/runtime/
lab-report/

# Python bytecode from local security tooling
__pycache__/
*.pyc

# Help screenshot capture: saved browser session and unreviewed output.
.help-shots/
